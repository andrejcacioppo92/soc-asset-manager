# Modello di configurazione per l'avvio con Docker Compose
# Copia questo file come .env.docker e inserisci i valori reali
# Avvio: docker compose --env-file .env.docker up --build

# credenziali del database PostgreSQL containerizzato
DB_USERNAME=postgres
DB_PASSWORD=cambia-questa-password

# chiave API di Google Gemini per la generazione dei piani di mitigazione
GEMINI_API_KEY=inserisci-qui-la-tua-chiave-gemini